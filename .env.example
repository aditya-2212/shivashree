# ─── Supabase PostgreSQL ──────────────────────────────────────────────────────
# Get both from: Supabase Dashboard → Project → Settings → Database → Connection string
#
# "Transaction" mode (port 6543) — used at runtime by Prisma through the pooler.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# "Session" mode / direct connection (port 5432) — used ONLY by `prisma migrate`.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."          # safe to expose to browser
SUPABASE_SERVICE_ROLE_KEY="eyJ..."              # NEVER expose to browser

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# On Vercel: set this to your production domain BEFORE the first deploy
NEXTAUTH_URL="https://yourdomain.com"

# ─── Admin Seed User ──────────────────────────────────────────────────────────
# Used ONLY once by `npm run seed` to create the first admin account
ADMIN_EMAIL="admin@shivashreedev.com"
ADMIN_PASSWORD="ChangeThisStrongPassword!"
ADMIN_NAME="Shivashree Admin"

# ─── Google Analytics ─────────────────────────────────────────────────────────
# GA4 Measurement ID (format: G-XXXXXXXXXX) — leave empty to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ─── Resend (Contact Us form → email only, no admin lead) ─────────────────────
# https://resend.com — create API key, verify sending domain, then set:
RESEND_API_KEY=""
# Must be an address on your verified domain (e.g. enquiries@yourdomain.com)
EMAIL_FROM=""
# Inbox for contact-page submissions (defaults to sales@sivasree.com if unset)
SALES_INBOX_EMAIL=""
