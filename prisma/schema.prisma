// ─── Hero Slides ──────────────────────────────────────────────────────────────

model HeroSlide {
  id             Int      @id @default(autoincrement())
  imageUrl       String
  eyebrow        String?
  overlayHeading String
  subheading     String?
  ctaLabel       String   @default("View Projects")
  ctaUrl         String   @default("/projects")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("hero_slides")
}
