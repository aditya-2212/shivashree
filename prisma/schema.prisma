generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // For Supabase: DATABASE_URL is the *pooled* connection string (port 6543).
  // DIRECT_URL is the *direct* connection string (port 5432) used for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Admin Users ──────────────────────────────────────────────────────────────

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      AdminRole @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

// ─── Properties ───────────────────────────────────────────────────────────────

model Property {
  id               Int              @id @default(autoincrement())
  title            String
  slug             String           @unique
  city             String
  locality         String
  fullAddress      String           @db.Text
  status           PropertyStatus   @default(PROPOSED)
  priceStartingFrom Float?
  reraNumber       String?
  heroImage        String?
  heroImageAlt     String?
  bhkTypes         String           @db.Text // JSON array stored as string
  highlights       String           @db.Text // JSON array
  keySpecifications String          @db.Text // JSON object: { building: "", kitchen: "", bathroom: "" }
  locationAdvantages String         @db.Text // JSON array
  mapEmbedUrl      String?          @db.Text
  seoTitle         String?
  seoDescription   String?
  isPublished      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  galleryImages    PropertyGallery[]
  floorPlans       FloorPlan[]
  amenities        Amenity[]
  faqs             PropertyFAQ[]
  leads            Lead[]

  @@map("properties")
}

enum PropertyStatus {
  PROPOSED
  ONGOING
  COMPLETED
  SOLD_OUT
}

model PropertyGallery {
  id         Int      @id @default(autoincrement())
  propertyId Int
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_gallery")
}

model FloorPlan {
  id         Int      @id @default(autoincrement())
  propertyId Int
  label      String
  imageUrl   String
  sortOrder  Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("floor_plans")
}

model Amenity {
  id         Int      @id @default(autoincrement())
  propertyId Int
  icon       String
  label      String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("amenities")
}

model PropertyFAQ {
  id         Int      @id @default(autoincrement())
  propertyId Int
  question   String   @db.Text
  answer     String   @db.Text
  sortOrder  Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_faqs")
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

model BlogPost {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  excerpt         String    @db.Text
  body            String    @db.Text
  coverImage      String?
  authorName      String
  authorAvatar    String?
  category        String
  tags            String    @db.Text // JSON array
  readTimeMinutes Int       @default(5)
  // SEO overrides — fall back to title/excerpt when empty (see blog [slug] page).
  seoTitle        String?
  seoDescription  String?   @db.Text
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("blog_posts")
}

// ─── FAQs ─────────────────────────────────────────────────────────────────────

model FAQEntry {
  id        Int         @id @default(autoincrement())
  question  String      @db.Text
  answer    String      @db.Text
  category  FAQCategory @default(GENERAL)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("faq_entries")
}

enum FAQCategory {
  GENERAL
  BUYING
  SELLING
  RENTING
}

// ─── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id              Int        @id @default(autoincrement())
  name            String
  email           String?
  mobile          String
  lookingIn       String?
  projectEnquiry  String?
  propertyId      Int?
  source          String     @default("website")
  status          LeadStatus @default(NEW)
  notes           String?    @db.Text
  submittedAt     DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  property        Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

// ─── Site Settings ────────────────────────────────────────────────────────────

model SiteSettings {
  id                    Int    @id @default(1) // singleton row
  corporateOfficeAddress String @db.Text
  corporateOfficeEmail  String
  corporateOfficePhone  String
  registeredOfficeAddress String @db.Text
  registeredOfficeTel   String
  whatsappNumber        String
  facebookUrl           String?
  instagramUrl          String?
  youtubeUrl            String?
  // Google Maps "embed" URL (the src from the iframe Google gives you when you
  // click Share → Embed a map). Rendered in the website footer below the
  // corporate office address. Editable from the admin Site Settings page.
  corporateMapEmbedUrl  String? @db.Text
  footerText            String @db.Text

  // ─── Contact page copy ───────────────────────────────────────────────────────
  contactHeroEyebrow       String?
  contactHeroTitle         String? @db.Text
  contactHeroIntro         String? @db.Text
  contactCorporateLabel    String?
  contactRegisteredLabel   String?
  contactHoursTitle        String?
  contactHoursWeekdays     String?
  contactHoursSunday       String?
  contactHoursNote         String? @db.Text
  contactFormTitle         String?
  contactFormIntro         String? @db.Text

  // ─── About page copy ─────────────────────────────────────────────────────────
  aboutHeroEyebrow         String?
  aboutHeroTitle           String? @db.Text
  aboutHeroLead            String? @db.Text
  aboutStoryTitle          String?
  aboutStoryBodyHtml       String? @db.Text
  aboutCommitmentsTitle    String?
  aboutC1Title             String? @db.Text
  aboutC1Body              String? @db.Text
  aboutC2Title             String? @db.Text
  aboutC2Body              String? @db.Text
  aboutC3Title             String? @db.Text
  aboutC3Body              String? @db.Text
  aboutWhereTitle          String?
  aboutWhereIntro          String? @db.Text
  aboutCtaTitle            String?
  aboutCtaBody             String? @db.Text

  // ─── Homepage copy ────────────────────────────────────────────────────────────
  homeProjectsEyebrow      String?
  homeProjectsHeading      String? @db.Text
  homeProjectsSubheading   String? @db.Text
  homeWhyEyebrow           String?
  homeWhyHeading           String? @db.Text
  homeCard1Title           String?
  homeCard1Body            String? @db.Text
  homeCard1Image           String?
  homeCard2Title           String?
  homeCard2Body            String? @db.Text
  homeCard2Image           String?
  homeCard3Title           String?
  homeCard3Body            String? @db.Text
  homeCard3Image           String?
  homeCtaEyebrow           String?
  homeCtaHeading           String? @db.Text
  homeCtaBody              String? @db.Text
  homeFormTitle            String?
  homeFormNote             String? @db.Text
  homeCallLabel            String?
  homeCallSuffix           String?

  // ─── Per-page SEO meta (browser tab + Google snippet) ──────────────────────────
  homeMetaTitle            String? @db.Text
  homeMetaDescription      String? @db.Text
  aboutMetaTitle           String? @db.Text
  aboutMetaDescription     String? @db.Text
  contactMetaTitle         String? @db.Text
  contactMetaDescription   String? @db.Text
  faqsMetaTitle            String? @db.Text
  faqsMetaDescription      String? @db.Text

  // ─── About page — Vision & Mission ─────────────────────────────────────────────
  aboutVisionLabel         String?
  aboutVisionBody          String? @db.Text
  aboutMissionLabel        String?
  aboutMissionBody         String? @db.Text

  // ─── About page — Our Process ──────────────────────────────────────────────────
  aboutProcessEyebrow      String?
  aboutProcessHeading      String? @db.Text
  aboutProcess1Title       String?
  aboutProcess1Body        String? @db.Text
  aboutProcess2Title       String?
  aboutProcess2Body        String? @db.Text
  aboutProcess3Title       String?
  aboutProcess3Body        String? @db.Text
  aboutProcess4Title       String?
  aboutProcess4Body        String? @db.Text

  // ─── About page — Quality Guarantee ────────────────────────────────────────────
  aboutQualityEyebrow      String?
  aboutQualityHeading      String? @db.Text
  aboutQualityIntro        String? @db.Text
  aboutQualitySubheading   String?
  aboutQuality1Title       String?
  aboutQuality1Body        String? @db.Text
  aboutQuality2Title       String?
  aboutQuality2Body        String? @db.Text
  aboutQuality3Title       String?
  aboutQuality3Body        String? @db.Text
  aboutQuality4Title       String?
  aboutQuality4Body        String? @db.Text
  aboutQuality5Title       String?
  aboutQuality5Body        String? @db.Text

  // ─── About page — Our Promise ──────────────────────────────────────────────────
  aboutPromiseTitle        String?
  aboutPromiseNote         String? @db.Text
  aboutPromise1Label       String?
  aboutPromise1Desc        String? @db.Text
  aboutPromise2Label       String?
  aboutPromise2Desc        String? @db.Text
  aboutPromise3Label       String?
  aboutPromise3Desc        String? @db.Text
  aboutPromise4Label       String?
  aboutPromise4Desc        String? @db.Text

  // ─── FAQs page copy ────────────────────────────────────────────────────────────
  faqsHeroEyebrow          String?
  faqsHeroHeading          String? @db.Text
  faqsHeroIntro            String? @db.Text
  faqsCtaText              String? @db.Text
  faqsCtaButtonLabel       String?

  // ─── Resources — blog listing page ("Notes & guides") ──────────────────────────
  blogHeroEyebrow          String?
  blogHeroHeading          String? @db.Text
  blogHeroIntro            String? @db.Text
  blogEmptyText            String? @db.Text
  blogCtaText              String? @db.Text
  blogCtaButtonLabel       String?
  blogMetaTitle            String? @db.Text
  blogMetaDescription      String? @db.Text

  updatedAt             DateTime @updatedAt

  @@map("site_settings")
}

// ─── Hero Slides ──────────────────────────────────────────────────────────────

model HeroSlide {
  id             Int      @id @default(autoincrement())
  imageUrl       String
  eyebrow        String?
  overlayHeading String
  subheading     String?
  ctaLabel       String   @default("View Projects")
  ctaUrl         String   @default("/projects")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("hero_slides")
}
